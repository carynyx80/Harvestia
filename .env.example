# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://harvestia-api.up.railway.app
NEXT_PUBLIC_SITE_URL=https://harvestia-one.vercel.app

# Backend (Railway, server/)
CORS_ORIGINS=https://harvestia-one.vercel.app,http://localhost:5180

