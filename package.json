{
  "name": "harvestia",
  "version": "0.2.0",
  "private": true,
  "description": "Harvestia \u2014 a pixel-art Web3 farming economy.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 5180",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "api:dev": "npm --prefix server run dev",
    "api:test": "npm --prefix server test",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "15.5.28",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
