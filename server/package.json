{
  "name": "harvestia-api",
  "version": "0.1.0",
  "private": true,
  "description": "Harvestia backend API (Railway).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
