{
  "name": "harvestia-api",
  "version": "0.1.0",
  "private": true,
  "description": "Harvestia backend API (Railway).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "build": "prisma generate && rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_ENV=test tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.3.4",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "embedded-postgres": "17.5.0-beta.15",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
